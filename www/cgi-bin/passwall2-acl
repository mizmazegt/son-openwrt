// Lấy danh sách MAC đang có trong khu vực "chip chờ lưu" (thiết bị vừa chọn từ dropdown, chưa bấm Lưu)
function getPendingMacs(ruleId) {
  var container = document.getElementById('pending_' + ruleId);
  if (!container) return [];
  var chips = container.querySelectorAll('.pending-chip');
  var macs = [];
  for (var i = 0; i < chips.length; i++) {
    macs.push(chips[i].getAttribute('data-mac'));
  }
  return macs;
}

// Gộp MAC gõ tay (trong ô nhập) + MAC từ các chip chờ lưu thành 1 chuỗi MAC-only
// rồi ghi đè vào chính ô nhập (name="new_sources") ngay trước khi submit,
// đảm bảo dữ liệu gửi lên server luôn chỉ chứa địa chỉ MAC.
function syncNewSourcesField(ruleId) {
  var input = document.getElementById('src_' + ruleId);
  if (!input) return;
  var manual = input.value.trim();
  var manualList = manual.length ? manual.split(/\s+/) : [];
  var pending = getPendingMacs(ruleId);
  var all = manualList.concat(pending);

  var seen = {};
  var uniq = [];
  for (var i = 0; i < all.length; i++) {
    var key = all[i].toUpperCase();
    if (!seen[key]) {
      seen[key] = true;
      uniq.push(all[i]);
    }
  }
  input.value = uniq.join(' ');
}

// CẢI TIẾN LỚN: Tìm chính xác form thông qua Form ID để submit
function removeMac(ruleId, mac) {
  if (confirm("Xác nhận BỎ thiết bị " + mac + " khỏi danh sách?")) {
    var hiddenInput = document.getElementById('hidden_' + ruleId);
    var targetForm = document.getElementById('form_' + ruleId);

    if (hiddenInput && targetForm) {
      var list = hiddenInput.value.trim().split(/\s+/);
      var newList = list.filter(function(m) {
        return m.toUpperCase() !== mac.toUpperCase();
      });
      hiddenInput.value = newList.join(' ');

      // form.submit() không tự phát sinh sự kiện 'submit', nên gộp MAC thủ công tại đây
      // để không làm mất các thiết bị vừa chọn từ dropdown nhưng chưa bấm Lưu.
      syncNewSourcesField(ruleId);

      // Bấm lệnh Gửi (Submit)
      targetForm.submit();
    } else {
      alert("Lỗi: Không tìm thấy form để gửi dữ liệu.");
    }
  }
}

// Xoá 1 chip "chờ lưu" khỏi giao diện (chưa động tới dữ liệu đã lưu trên server)
function removePendingChip(chipEl) {
  if (chipEl && chipEl.parentNode) chipEl.parentNode.removeChild(chipEl);
}

// Khi chọn thiết bị từ dropdown: hiển thị đầy đủ MAC + IP + tên dưới dạng "chip",
// KHÔNG ghi thẳng vào ô nhập. Chuỗi MAC-only để lưu vào "sources" sẽ được gộp lại
// từ các chip này (xem syncNewSourcesField) ngay trước khi submit.
function addDeviceTo(selectEl) {
  var mac = selectEl.value;
  if (!mac) return;
  var targetId = selectEl.getAttribute('data-target');
  var input = document.getElementById(targetId);
  if (!input) return;

  var ruleId = targetId.replace('src_', '');
  var hiddenInput = document.getElementById('hidden_' + ruleId);
  var pendingContainer = document.getElementById('pending_' + ruleId);

  var listManual = input.value.trim().length ? input.value.trim().split(/\s+/) : [];
  var listOld = (hiddenInput && hiddenInput.value.trim().length) ? hiddenInput.value.trim().split(/\s+/) : [];
  var listPending = getPendingMacs(ruleId);

  var all = listManual.concat(listOld, listPending);
  var found = false;
  for (var i = 0; i < all.length; i++) {
    if (all[i].toUpperCase() === mac.toUpperCase()) { found = true; break; }
  }

  if (found) {
    alert("Thiết bị này đã tồn tại trong danh sách của Rule này!");
    selectEl.selectedIndex = 0;
    return;
  }

  var dev = null;
  for (var i = 0; i < DEVICES.length; i++) {
    if (DEVICES[i].mac.toUpperCase() === mac.toUpperCase()) { dev = DEVICES[i]; break; }
  }

  var chip = document.createElement('div');
  chip.className = 'hint-item pending-chip';
  chip.setAttribute('data-mac', mac);

  var macSpan = document.createElement('span');
  macSpan.className = 'hint-mac';
  macSpan.textContent = 'MAC: ' + mac;
  chip.appendChild(macSpan);

  if (dev && dev.ip) {
    var ipSpan = document.createElement('span');
    ipSpan.className = 'hint-ip';
    ipSpan.textContent = dev.ip;
    chip.appendChild(ipSpan);
  }
  if (dev && dev.name) {
    var nameSpan = document.createElement('span');
    nameSpan.className = 'hint-name';
    nameSpan.textContent = '💻 ' + dev.name;
    chip.appendChild(nameSpan);
  }

  var badge = document.createElement('span');
  badge.className = 'pending-badge';
  badge.textContent = '🕓 Sẽ thêm';
  chip.appendChild(badge);

  var removeBtn = document.createElement('span');
  removeBtn.className = 'remove-mac';
  removeBtn.title = 'Bỏ khỏi danh sách sẽ thêm';
  removeBtn.textContent = '❌ Bỏ';
  removeBtn.addEventListener('click', function () { removePendingChip(chip); });
  chip.appendChild(removeBtn);

  if (pendingContainer) pendingContainer.appendChild(chip);

  selectEl.selectedIndex = 0;
}

// Gắn sự kiện submit cho từng form để gộp MAC (gõ tay + chip chờ lưu) trước khi gửi đi
function attachFormSyncHandlers() {
  var forms = document.querySelectorAll('form[id^="form_"]');
  for (var i = 0; i < forms.length; i++) {
    (function (form) {
      var ruleId = form.id.replace('form_', '');
      form.addEventListener('submit', function () {
        syncNewSourcesField(ruleId);
      });
    })(forms[i]);
  }
}

function ipToComparable(ip) {
  if (!ip) return null;
  var parts = ip.split('.');
  if (parts.length !== 4) return null;
  var n = 0;
  for (var i = 0; i < 4; i++) {
    var v = parseInt(parts[i], 10);
    if (isNaN(v)) return null;
    n = n * 256 + v;
  }
  return n;
}

function sortDevicesByIp(list) {
  return list.slice().sort(function (a, b) {
    var ia = ipToComparable(a.ip);
    var ib = ipToComparable(b.ip);
    if (ia === null && ib === null) return 0;
    if (ia === null) return 1;  // không có IP -> xếp xuống cuối
    if (ib === null) return -1;
    return ia - ib;
  });
}

function populateDeviceSelects() {
  var sortedDevices = sortDevicesByIp(DEVICES);
  var selects = document.querySelectorAll('.device-select');
  for (var s = 0; s < selects.length; s++) {
    var sel = selects[s];
    var ph = document.createElement('option');
    ph.value = '';
    ph.textContent = sortedDevices.length ? '➕ Chọn thiết bị để thêm vào ô nhập...' : '(không quét được thiết bị nào)';
    sel.appendChild(ph);
    for (var d = 0; d < sortedDevices.length; d++) {
      var dev = sortedDevices[d];
      var opt = document.createElement('option');
      opt.value = dev.mac;
      var label = dev.mac;
      if (dev.ip) label += '   [ ' + dev.ip + ' ]';
      if (dev.name) label += '   - ' + dev.name;
      opt.textContent = label;
      sel.appendChild(opt);
    }
    sel.addEventListener('change', function (e) { addDeviceTo(e.target); });
  }
}
document.addEventListener('DOMContentLoaded', function () {
  populateDeviceSelects();
  attachFormSyncHandlers();
});
JSBLOCK
echo "</script>"

awk -v sq="'" -v now="$NOW" -v script="$SCRIPT_NAME" -v savedid="$SAVED_ID" -v hostsfile="$HOSTS_TMP" '
BEGIN {
  insection = 0
  n = 0
  while ((getline hline < hostsfile) > 0) {
    hn = split(hline, harr, "|")
    hmac = harr[1]
    hostip[hmac] = harr[2]
    hostname[hmac] = harr[3]
  }
  close(hostsfile)
}
/^[ \t]*config[ \t]+/ {
  line = $0
  sub(/^[ \t]*config[ \t]+/, "", line)
  sp = index(line, " ")
  if (sp > 0) {
    ctype = substr(line, 1, sp-1)
    cname = substr(line, sp+1)
  } else {
    ctype = line
    cname = ""
  }
  gsub(sq, "", cname)
  gsub(/^[ \t]+|[ \t]+$/, "", cname)
  if (ctype == "acl_rule") {
    insection = 1
    n++
    order[n] = (cname != "" ? cname : ("rule" n))
    cur = order[n]
  } else {
    insection = 0
  }
  next
}
insection == 1 && /^[ \t]+option[ \t]+/ {
  line = $0
  sub(/^[ \t]+option[ \t]+/, "", line)
  sp = index(line, " ")
  if (sp == 0) next
  optname = substr(line, 1, sp-1)
  optval = substr(line, sp+1)
  gsub(/^[ \t]+/, "", optval)
  if (substr(optval,1,1) == sq) {
    optval = substr(optval, 2, length(optval)-2)
  }
  data[cur, optname] = optval
  oc[cur]++
  ok[cur, oc[cur]] = optname
  next
}
insection == 1 && /^[ \t]+list[ \t]+/ {
  # list sources chua 1 MAC tren 1 dong rieng, thay cho option sources cu
  # gop nhieu MAC tren 1 dong. Gop lai thanh chuoi cach nhau bang khoang trang
  # trong listsrc[cur] de phan hien thi/JS ben duoi khong can doi gi them.
  line = $0
  sub(/^[ \t]+list[ \t]+/, "", line)
  sp = index(line, " ")
  if (sp == 0) next
  optname = substr(line, 1, sp-1)
  optval = substr(line, sp+1)
  gsub(/^[ \t]+/, "", optval)
  if (substr(optval,1,1) == sq) {
    optval = substr(optval, 2, length(optval)-2)
  }
  if (optname == "sources") {
    listsrc[cur] = (listsrc[cur] == "" ? optval : listsrc[cur] " " optval)
  }
  next
}
END {
  if (n == 0) {
    print "<div class=\"hint-empty\">Không tìm thấy mục cấu hình acl_rule nào.</div>"
    exit 0
  }
  print "<table>"
  print "<colgroup><col class=\"col-rule\"><col><col class=\"col-action\"></colgroup>"
  print "<thead><tr><th>Tên Rule</th><th style=\"min-width:340px\">Quản lý Thiết bị (MAC / IP)</th><th style=\"text-align:center\">Hành động</th></tr></thead><tbody>"
  for (i=1;i<=n;i++) {
    s = order[i]
    remarks = data[s,"remarks"]; if (remarks=="") remarks="-"
    enabled = data[s,"enabled"]
    if (enabled=="1") enh="<span class=\"badge-on\">Đang bật</span>"; else enh="<span class=\"badge-off\">Đã tắt</span>"
    # Ưu tiên dữ liệu từ "list sources" (định dạng mới, nhiều dòng); nếu không có
    # thì fallback về "option sources" cũ (1 dòng nhiều MAC) để tương thích ngược.
    rawsrc = (listsrc[s] != "" ? listsrc[s] : data[s,"sources"])
    rowclass = (s==savedid) ? " class=\"row-saved\"" : ""

    inputid = "src_" s
    hiddenid = "hidden_" s
    formid = "form_" s

    hint = ""
    if (rawsrc != "") {
      m = split(rawsrc, macs, / +/)
      for (mi=1; mi<=m; mi++) {
        mc = toupper(macs[mi])
        ipaddr = hostip[mc]
        nm = hostname[mc]

        safemac = mc; gsub(/:/, "", safemac)
        chipid = "chip_" s "_" safemac

        if (ipaddr != "") {
          lbl = "<span class=\"hint-mac\">MAC: " mc "</span><span class=\"hint-ip\">" ipaddr "</span>"
          if (nm != "") lbl = lbl "<span class=\"hint-name\">💻 " nm "</span>"
        } else {
          lbl = "<span class=\"hint-mac\">MAC: " mc "</span><span style=\"color:#d8c690; font-size:13px; margin-left:6px;\"><em>(Chưa lấy được IP)</em></span>"
        }
        # Thêm nut onclick goi javascript (dung bien sq thay vi dau nhay don truc tiep,
        # vi ca khoi awk nay dang nam trong cap dau nhay don cua shell)
        lbl = lbl "<span class=\"remove-mac\" onclick=\"removeMac(" sq s sq ", " sq mc sq ")\" title=\"Xóa thiết bị này khỏi danh sách\">❌ Bỏ</span>"
        hint = hint "<div class=\"hint-item\" id=\"" chipid "\">" lbl "</div>"
      }
    }

    print "<tr" rowclass ">"
    print "<td><strong style=\"color:#e5e7eb\">" remarks "</strong></td>"
    print "<td>"
    if (hint != "") {
        print "<div class=\"src-hint\">" hint "</div>"
    }
    print "<div class=\"src-hint pending-hint\" id=\"pending_" s "\"></div>"

    # GÁN ID CHO FORM: "id=\"" formid "\"" — nút Lưu nằm ở cột riêng, liên kết qua thuộc tính form=
    print "<form id=\"" formid "\" class=\"edit-form\" method=\"post\" action=\"" script "\">"
    print "<input type=\"hidden\" name=\"section\" value=\"" s "\">"
    print "<input type=\"hidden\" id=\"" hiddenid "\" name=\"sources\" value=\"" rawsrc "\">"
    print "<input type=\"text\" id=\"" inputid "\" name=\"new_sources\" value=\"\" pattern=\"[0-9A-Fa-f: ]*\" title=\"Địa chỉ MAC, cách nhau bởi khoảng trắng\" placeholder=\"Nhập thêm MAC mới vào đây...\">"
    print "</form>"
    print "<select class=\"device-select\" data-target=\"" inputid "\"></select>"
    print "</td>"
    print "<td class=\"action-cell\">"
    print "<button type=\"submit\" form=\"" formid "\" class=\"btn-save\">💾 Lưu</button>"
    print "</td>"
    print "</tr>"
  }
  print "</tbody></table>"
}
' "$CONFIG_FILE"

echo "</body></html>"
rm -f "$HOSTS_TMP"
