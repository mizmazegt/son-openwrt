#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99  # Đảm bảo chạy sau cùng khi mạng và các dịch vụ khác đã lên hết
STOP=15

start_service() {
    procd_open_instance

    # Chỉ định đường dẫn tới file script của bạn
    procd_set_param command /bin/sh "/usr/bin/listen_api.sh"

    # Nếu script chết, procd tự động bật lại
    procd_set_param respawn

    # Chờ tối đa 10 giây sau SIGTERM (phòng lúc script đang xử lý uci/firewall) rồi mới SIGKILL
    procd_set_param term_timeout 10

    # Ghi log chuẩn của OpenWrt (xem bằng lệnh logread)
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}
