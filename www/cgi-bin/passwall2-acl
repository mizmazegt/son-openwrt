#!/bin/sh
# passwall2-acl.cgi

CONFIG_FILE="/etc/config/passwall2"
DHCP_LEASES="/tmp/dhcp.leases"
DHCP_CONFIG="/etc/config/dhcp"
ARP_TABLE="/proc/net/arp"
PKG="passwall2"
SCRIPT_NAME="${SCRIPT_NAME:-/cgi-bin/passwall2-acl}"

# ---------- helper: giai ma URL-encoded string ----------
urldecode() {
  printf '%s' "$1" | awk '
  function hex2dec(h,   i,c,v,r) {
    h = toupper(h)
    r = 0
    for (i = 1; i <= length(h); i++) {
      c = substr(h, i, 1)
      v = index("0123456789ABCDEF", c) - 1
      r = r * 16 + v
    }
    return r
  }
  {
    s = $0
    gsub(/\+/, " ", s)
    out = ""
    i = 1
    n = length(s)
    while (i <= n) {
      c = substr(s, i, 1)
      if (c == "%" && i + 2 <= n) {
        out = out sprintf("%c", hex2dec(substr(s, i + 1, 2)))
        i += 3
      } else {
        out = out c
        i += 1
      }
    }
    printf "%s", out
  }'
}

html_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# ---------- helper: quet thiet bi tren mang ----------
build_hosts() {
  {
    if [ -f "$DHCP_LEASES" ]; then
      awk '{ mac=toupper($2); ip=$3; host=$4; if (host=="*") host=""; print mac "|" ip "|" host }' "$DHCP_LEASES"
    fi
    if [ -f "$DHCP_CONFIG" ]; then
      awk -v sq="'" '
      /^[ \t]*config[ \t]+host([ \t]|$)/ {
        if (insec && mac!="") print toupper(mac) "|" ip "|" name
        insec=1; mac=""; ip=""; name=""; next
      }
      /^[ \t]*config[ \t]+/ {
        if (insec && mac!="") print toupper(mac) "|" ip "|" name
        insec=0; next
      }
      insec && /^[ \t]+option[ \t]+mac[ \t]+/ {
        line=$0; sub(/^[ \t]+option[ \t]+mac[ \t]+/,"",line); gsub(sq,"",line); gsub(/^[ \t]+|[ \t]+$/,"",line); mac=line; next
      }
      insec && /^[ \t]+option[ \t]+ip[ \t]+/ {
        line=$0; sub(/^[ \t]+option[ \t]+ip[ \t]+/,"",line); gsub(sq,"",line); gsub(/^[ \t]+|[ \t]+$/,"",line); ip=line; next
      }
      insec && /^[ \t]+option[ \t]+name[ \t]+/ {
        line=$0; sub(/^[ \t]+option[ \t]+name[ \t]+/,"",line); gsub(sq,"",line); gsub(/^[ \t]+|[ \t]+$/,"",line); name=line; next
      }
      END { if (insec && mac!="") print toupper(mac) "|" ip "|" name }
      ' "$DHCP_CONFIG"
    fi
    if [ -f "$ARP_TABLE" ]; then
      awk 'NR>1 { if ($4 != "00:00:00:00:00:00") print toupper($4) "|" $1 "|" }' "$ARP_TABLE"
    fi
  } | awk -F'|' '!seen[$1]++'
}

# ================= XU LY POST (LUU DU LIEU) =================
if [ "$REQUEST_METHOD" = "POST" ]; then
  LEN="${CONTENT_LENGTH:-0}"
  BODY=""
  if [ "$LEN" -gt 0 ] 2>/dev/null; then
    BODY=$(dd bs="$LEN" count=1 2>/dev/null)
  fi

  SECTION=""
  SOURCES=""
  NEW_SOURCES=""

  OLDIFS="$IFS"
  IFS='&'
  set -- $BODY
  IFS="$OLDIFS"
  for kv in "$@"; do
    key="${kv%%=*}"
    val="${kv#*=}"
    case "$key" in
      section) SECTION=$(urldecode "$val") ;;
      sources) SOURCES=$(urldecode "$val") ;;
      new_sources) NEW_SOURCES=$(urldecode "$val") ;;
    esac
  done

  if [ -n "$NEW_SOURCES" ]; then
    SOURCES="$SOURCES $NEW_SOURCES"
  fi

  SOURCES=$(printf '%s' "$SOURCES" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g')

  ERR=""
  case "$SECTION" in
    ""|*[!A-Za-z0-9_]*) ERR="ID rule khong hop le." ;;
  esac
  if [ -z "$ERR" ]; then
    if [ ! -f "$CONFIG_FILE" ]; then
      ERR="Khong tim thay file cau hinh."
    elif ! grep -qE "^config[[:space:]]+acl_rule[[:space:]]+'${SECTION}'" "$CONFIG_FILE"; then
      ERR="Khong tim thay ACL rule voi ID nay."
    fi
  fi

  # CẢI TIẾN: Cho phép chuỗi trống (để xóa hoàn toàn thiết bị)
  if [ -z "$ERR" ]; then
    if [ -n "$SOURCES" ]; then
      case "$SOURCES" in
        *[!0-9A-Fa-f:\ ]*) ERR="Dinh dang MAC khong hop le. Chi cho phep so hex, dau : va khoang trang giua cac MAC." ;;
      esac
    fi
  fi

  if [ -z "$ERR" ]; then
    # "sources" giờ là "list" (nhiều dòng, mỗi dòng 1 MAC) thay vì "option" (1 dòng nhiều MAC).
    # Xoá toàn bộ list cũ trước, sau đó add_list lại từng MAC một -> mỗi MAC thành 1 dòng
    # "list sources '...'" riêng biệt trong file cấu hình.
    uci delete "${PKG}.${SECTION}.sources" >/dev/null 2>&1
    if [ -n "$SOURCES" ]; then
      for mac in $SOURCES; do
        uci add_list "${PKG}.${SECTION}.sources=${mac}" >/dev/null 2>&1
      done
    fi

    uci commit "$PKG" >/dev/null 2>&1
    ( [ -x /etc/init.d/passwall2 ] && /etc/init.d/passwall2 reload >/dev/null 2>&1 ) &
    echo "Status: 303 See Other"
    echo "Location: ${SCRIPT_NAME}?saved=${SECTION}"
    echo ""
    exit 0
  fi

  echo "Content-Type: text/html; charset=utf-8"
  echo ""
  echo "<!DOCTYPE html><html lang=\"vi\"><head><meta charset=\"UTF-8\"><title>Loi</title></head><body>"
  echo "<strong>Khong the luu:</strong> $(html_escape "$ERR")<br><a href=\"${SCRIPT_NAME}\">Quay lai</a></body></html>"
  exit 0
fi

# ================= XU LY GET (HIEN THI TRANG) =================
NOW=$(date '+%Y-%m-%d %H:%M:%S')
SAVED_ID=""
case "$QUERY_STRING" in
  saved=*) SAVED_ID="${QUERY_STRING#saved=}"; SAVED_ID=$(urldecode "$SAVED_ID") ;;
esac

HOSTS_TMP="/tmp/.passwall2acl_hosts.$$"
build_hosts > "$HOSTS_TMP" 2>/dev/null

echo "Content-Type: text/html; charset=utf-8"
echo ""

